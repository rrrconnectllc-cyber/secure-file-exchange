{
  "buildCommand": "npm run build --workspace=@sfx/web",
  "outputDirectory": "apps/web/.next",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.sfxlegal.org/api/:path*"
    }
  ],
  "env": {
    "NEXT_PUBLIC_API_URL": "https://api.sfxlegal.org",
    "NEXT_PUBLIC_APP_URL": "https://sfxlegal.org"
  }
}
